#!/bin/sh
#
# Block commits authored/committed as the agent identity "Agent <agent@local>".
# Expected identity: Константин Шмирко <physicist2018@yandex.ru>.
#
# Escape hatch (discouraged): AGENT_AUTHOR_OK=1 git commit ...

if [ "${AGENT_AUTHOR_OK:-}" = "1" ]; then
    exit 0
fi

ident_author=$(git var GIT_AUTHOR_IDENT 2>/dev/null) || exit 0
ident_committer=$(git var GIT_COMMITTER_IDENT 2>/dev/null) || exit 0

# Print "name <email>" parsed from a "Name <email> <timestamp> <tz>" ident line.
ident_name() {
    printf '%s\n' "$1" | sed -n 's/^\([^<]*\)<.*/\1/p' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//'
}

ident_email() {
    printf '%s\n' "$1" | sed -n 's/.*<\([^>]*\)>.*/\1/p'
}

is_agent_ident() {
    name=$(ident_name "$1")
    email=$(ident_email "$1")
    [ "$email" = "agent@local" ] || [ "$name" = "Agent" ]
}

if is_agent_ident "$ident_author" || is_agent_ident "$ident_committer"; then
    cat >&2 <<'MSG'

=== Commit blocked: agent identity detected ===

Author   : Agent <agent@local> is not allowed
Committer: Agent <agent@local> is not allowed

Expected: Константин Шмирко <physicist2018@yandex.ru>

This is usually caused by GIT_AUTHOR_* / GIT_COMMITTER_* environment
variables overriding the repository config. Check and clear them:

    env | grep '^GIT_'
    unset GIT_AUTHOR_NAME GIT_AUTHOR_EMAIL GIT_AUTHOR_DATE
    unset GIT_COMMITTER_NAME GIT_COMMITTER_EMAIL GIT_COMMITTER_DATE

Then verify the configured identity:

    git config user.name
    git config user.email

To fix the commit that was just created with the wrong identity:

    git commit --amend --reset-author --no-edit

To bypass this check once (not recommended): AGENT_AUTHOR_OK=1 git commit ...

MSG
    exit 1
fi

exit 0
